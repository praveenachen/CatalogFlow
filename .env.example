# Application state database (SQLite locally; PostgreSQL in production)
DATABASE_URL=sqlite:///./catalogflow.db

# local | s3
CATALOG_STORAGE=local
LOCAL_CATALOG_STORAGE_ROOT=.catalogflow-data
AWS_REGION=us-east-1
AWS_S3_BUCKET=replace-with-private-bucket

# local | databricks
CATALOG_PROCESSOR=local
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=replace-with-secret-or-use-supported-auth-chain
DATABRICKS_JOB_ID=123456789
